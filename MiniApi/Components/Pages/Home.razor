@page "/"
@rendermode InteractiveServer

<PageTitle>MiniApi Explorer</PageTitle>

<div class="container py-4 py-lg-5">
    <header class="hero-panel p-4 p-lg-5 mb-4 rounded-4 shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-8 hero-copy">
                <h1 class="display-4 fw-bold mt-3">Explore the world,<br /></h1>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-link text-white text-decoration-none" @onclick="LoadDashboardAsync">↻ Refresh data</button>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-flex justify-content-center">
                <div class="globe-mark" aria-hidden="true">◉</div>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">@ErrorMessage</div>
    }

    <section class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <span class="stat-label">API status</span>
                    <strong class="stat-value"><span class="status-dot"></span>@HelloMessage</strong>
                    <span class="stat-caption">Connected</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <span class="stat-label">Countries loaded</span>
                    <strong class="stat-value">@Countries.Count</strong>
                    <span class="stat-caption">Records matching your view</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <span class="stat-label">Current region</span>
                    <strong class="stat-value">@(string.IsNullOrWhiteSpace(SelectedRegion) ? "All regions" : SelectedRegion)</strong>
                    <span class="stat-caption">Use the filters below to explore</span>
                </div>
            </div>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
                <div>
                    <span class="eyebrow">COUNTRY DIRECTORY</span>
                    <h2 class="h3 mb-0 mt-1">Find your next destination</h2>
                </div>
                <span class="result-count">@Countries.Count result@(Countries.Count == 1 ? "" : "s")</span>
            </div>

            <div class="row g-3 align-items-end mb-4">
                <div class="col-lg-6">
                    <label class="form-label">Search countries</label>
                    <input class="form-control" @bind="SearchText" @onkeyup="OnSearchKeyUp" placeholder="Try Sweden or swe" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label">Region</label>
                    <select class="form-select" value="@SelectedRegion" @onchange="OnRegionChanged">
                        <option value="">All regions</option>
                        @foreach (var region in Regions)
                        {
                            <option value="@region">@region</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <button class="btn btn-primary w-100" @onclick="ApplyFiltersAsync">⌕ Apply filters</button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="d-flex flex-column align-items-center justify-content-center gap-3 py-5 text-secondary">
                    <div class="spinner-border text-primary" role="status"></div>
                    <span>Loading country data...</span>
                </div>
            }
            else if (Countries.Count == 0)
            {
                <div class="text-center py-5 text-secondary">
                    <div class="empty-icon">◎</div>
                    <h3 class="h5 text-dark">No countries found</h3>
                    <p class="mb-0">Try clearing one of your filters.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                    @foreach (var country in Countries)
                    {
                        <div class="col">
                            <button class="country-card card w-100 h-100 text-start" @onclick="() => ShowDetailsAsync(country.Id)">
                                <div class="card-body d-flex align-items-center gap-3">
                                    <div class="flag-wrap">
                                        @if (!string.IsNullOrWhiteSpace(country.FlagUrl))
                                        {
                                            <img src="@country.FlagUrl" alt="@($"{country.Choice} flag")" />
                                        }
                                        else
                                        {
                                            <span class="fallback-flag">⚑</span>
                                        }
                                    </div>
                                    <div class="country-info flex-grow-1">
                                        <div class="country-name">@country.Choice</div>
                                        <div class="country-meta">@country.Capital · @country.Region</div>
                                    </div>
                                    <span class="card-arrow">→</span>
                                </div>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

</div>

@if (SelectedCountry is not null)
{
    <div class="modal-backdrop" @onclick="CloseDetails">
        <section class="details-modal" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="modal-heading">
                <h2>@SelectedCountry.Choice</h2>
                <button class="modal-close" @onclick="CloseDetails" aria-label="Close">×</button>
            </div>
            <div class="details-content">
                @if (!string.IsNullOrWhiteSpace(SelectedCountry.FlagUrl))
                {
                    <img class="detail-flag" src="@SelectedCountry.FlagUrl" alt="@($"{SelectedCountry.Choice} flag")" />
                }
                <div class="detail-grid">
                    <div><span>Capital</span><strong>@(SelectedCountry.Capital ?? "—")</strong></div>
                    <div><span>Region</span><strong>@(SelectedCountry.Region ?? "—")</strong></div>
                    <div><span>Subregion</span><strong>@(SelectedCountry.Subregion ?? "—")</strong></div>
                    <div><span>Population</span><strong>@(SelectedCountry.Population?.ToString("N0") ?? "—")</strong></div>
                    <div><span>Area</span><strong>@(SelectedCountry.Area?.ToString("N0") ?? "—") km²</strong></div>
                    <div><span>Coordinates</span><strong>@(SelectedCountry.Latitude?.ToString("0.##") ?? "—"), @(SelectedCountry.Longitude?.ToString("0.##") ?? "—")</strong></div>
                </div>
            </div>
            <div class="modal-actions"><button class="button button-primary" @onclick="CloseDetails">Close</button></div>
        </section>
    </div>
}
